# IG_CRM production env. Copy to `.env` (in repo root next to
# docker-compose.prod.yml) and fill in the bracketed fields.
#
# Once filled:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Anything blank/missing → the container will refuse to start with a
# pydantic-settings validation error (preferable to a silent misconfig).

# ── DOMAIN ────────────────────────────────────────────────────────────────
# DNS A-record must already point this server's public IP.
# Caddy uses this to auto-provision a Let's Encrypt cert.
DOMAIN=api.yourdomain.com

# ── SECURITY ──────────────────────────────────────────────────────────────
# Generate ONCE and never change in prod (changing it invalidates ALL JWTs
# AND breaks Fernet decryption of stored cookies/passwords):
#   openssl rand -hex 32
SECRET_KEY=__REPLACE_ME__GENERATE_WITH_openssl_rand_hex_32__

# Token expiry. 1440 = 24h. Tighten for prod if your users are OK with it.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── DATABASE ──────────────────────────────────────────────────────────────
# Postgres lives in the docker-compose stack. Hostname `postgres` is the
# service name (docker DNS). Keep the password long and random.
POSTGRES_USER=ig_user
POSTGRES_PASSWORD=__REPLACE_ME__strong_random_password__
POSTGRES_DB=ig_crm
DATABASE_URL=postgresql+psycopg://ig_user:__SAME_AS_POSTGRES_PASSWORD__@postgres:5432/ig_crm

# ── REDIS / CELERY ────────────────────────────────────────────────────────
# Internal-only on the docker network, no auth needed.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────
# Default below: Ollama Cloud (free tier). Permanent key — paste your own
# if rotated. To use OpenAI instead:
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=0d3b420c426e4714a74939f91fcf63cd.EDt3tA0LnXVAMET7P9dgqvpZ
OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_MODEL=gpt-oss:20b

# ── ADMIN ─────────────────────────────────────────────────────────────────
# Comma-separated emails that get the admin role (capacity panel, grant
# tiers/agents to other users). Must match the email a user REGISTERS with.
ADMIN_EMAILS=you@yourdomain.com

# ── CORS ──────────────────────────────────────────────────────────────────
# JSON list. Set to the frontend's actual origin (Vercel URL or your own
# domain). "*" works for dev but lets ANY site hit the API.
CORS_ALLOWED_ORIGINS=["https://app.yourdomain.com","https://your-vercel-app.vercel.app"]

# ── BROWSER FLEET TUNING ──────────────────────────────────────────────────
# How many parallel Celery worker children. Each can run one browser.
# Rule of thumb: (vCPU - 1) browsers, and (RAM_GB / 2) browsers.
# Default below: 2 — fits a 2-core / 8GB VPS comfortably (one core for OS +
# postgres + redis + caddy, second for actively running browsers).
# On a beefier 4-core/16GB box bump to 3-4.
WORKER_CONCURRENCY=2

# How many uvicorn workers (HTTP). API is light, 1-2 is plenty.
API_WORKERS=1

# Per-tier defaults for agents_limit; admin can override per-user.
AGENTS_FREE=1
AGENTS_PRO=3
AGENTS_ENTERPRISE=5

# Host capacity soft-gate: refuse to start a new task above these thresholds.
# 85% is safe — leaves enough headroom for the OS not to swap.
CAPACITY_CPU_PERCENT=85.0
CAPACITY_RAM_PERCENT=85.0
# Hard ceiling of CONCURRENT browsers on this host. Each browser ~500MB RAM
# + ~50MB for the pproxy auth-forwarder = ~550MB. On 8GB box: 2 is the
# safe sweet spot (room left for postgres/redis/caddy/OS).
CAPACITY_MAX_BROWSERS=2

# MUST be true on a GUI-less server — Chrome refuses to start without a
# display otherwise. Only set to false on a local dev machine where you
# want to watch the browser work visually.
BROWSER_HEADLESS=true

# ── TRUST GATE ────────────────────────────────────────────────────────────
# 0 = accept any proxy. 50 = production-strict (kills tasks before launch
# if proxy looks bad / no cookies / poor UA). Raise to 50 once your proxies
# are reliable.
MIN_TRUST_SCORE=0

# Allow tasks with NO proxy attached (direct IG from server IP). Admins
# bypass this anyway. Leave FALSE in production.
ALLOW_NO_PROXY=false

# ── LOGGING ───────────────────────────────────────────────────────────────
# LOG_DIR must exist inside the container; the docker volume `ig_crm_logs`
# maps to it. Files: api.log, worker.log, beat.log (rotated 20MB x 5).
LOG_LEVEL=INFO
LOG_DIR=/var/log/ig_crm
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5

# ── MEDIA ─────────────────────────────────────────────────────────────────
# Inside the container — maps to the `ig_crm_media` volume. Don't change
# unless you also change the volume mount in docker-compose.
MEDIA_ROOT=/app/media

# ffmpeg / ffprobe are pre-installed in the image at the system path.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
